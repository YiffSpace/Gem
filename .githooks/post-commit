#!/usr/bin/env bash
set -euo pipefail

VERSION_FILE="lib/yiffspace/version.rb"

# Only run if the version file was touched in this commit
if ! git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -qF "$VERSION_FILE"; then
  exit 0
fi

VERSION=$(ruby -e "load '$VERSION_FILE'; puts YiffSpace::VERSION")
TAG="v${VERSION}"

if git tag --list | grep -qxF "$TAG"; then
  echo "[post-commit] $TAG already exists — skipping release"
  exit 0
fi

echo "[post-commit] version file changed → $TAG"

echo "[post-commit] running rubocop..."
if ! bundle exec rubocop --no-color; then
  echo "[post-commit] rubocop failed — skipping release"
  exit 0
fi

echo "[post-commit] running zeitwerk check..."
if ! bundle exec ruby -e "require('yiffspace'); Zeitwerk::Loader.eager_load_all"; then
  echo "[post-commit] zeitwerk check failed — skipping release"
  exit 0
fi

PREV_TAG=$(git tag --sort=-version:refname | head -1)
if [ -n "$PREV_TAG" ]; then
  NOTES=$(git log --pretty=format:"- %s" "${PREV_TAG}..HEAD")
else
  NOTES=$(git log --pretty=format:"- %s")
fi

rollback() {
  echo "[post-commit] rolling back commit..."
  git reset --soft HEAD~1
}

echo "[post-commit] pushing..."
if ! git push; then
  echo "[post-commit] push failed — rolling back commit"
  rollback
  exit 1
fi

echo "[post-commit] creating GitHub release $TAG..."
if ! gh release create "$TAG" --title "$VERSION" --notes "$NOTES"; then
  echo "[post-commit] release failed"
  exit 1
fi

echo "[post-commit] release $TAG created"
